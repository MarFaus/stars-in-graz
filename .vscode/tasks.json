{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start server",
      "type": "shell",
      "command": "php",
      "args": ["-S", "localhost:8000", "router.php"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Open site in browser",
      "type": "shell",
      "command": "start http://localhost:8000/module-b/",
      "problemMatcher": []
    }
  ]
}
